# ============================================================
# SecureMailScope Frontend — Environment Variables Template
# Copy this file to .env (for local dev) or .env.production
# NEVER commit .env or .env.production with real secrets.
# ============================================================

# Backend API base URL (no trailing slash, no /api suffix)
# Local dev:
VITE_API_BASE_URL=http://localhost:8001
# Production:
# VITE_API_BASE_URL=https://api.mailscope.dpdns.org

# Site URL — used as OAuth redirect base when window is unavailable (SSR / build time).
# Local dev:
VITE_SITE_URL=http://localhost:5173
# Production:
# VITE_SITE_URL=https://mailscope.dpdns.org

# Supabase — public-safe anon key (safe to commit/deploy).
# Found in Supabase Dashboard → Project Settings → API → anon (public) key
VITE_SUPABASE_URL=https://ymwflcngyzawphnvezmr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Legacy name for the same anon key, read only if VITE_SUPABASE_PUBLISHABLE_KEY
# is unset (frontend/src/lib/supabase.js). Set one or the other, not both.
#VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
