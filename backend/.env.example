# ============================================================
# SecureMailScope Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API → JWT Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your_project_ref_here

# JWT Secret — used to verify HS256-signed Supabase tokens locally.
# Required in production. Found in Supabase → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Alternative name for the HS256 secret, read only if SUPABASE_JWT_SECRET is
# unset (backend/app/core/auth.py). Set one or the other, not both.
#JWT_SECRET=your_supabase_jwt_secret_here

# Asymmetric verification (ES256 / RS256) instead of HS256: the project's
# public key in PEM form. SUPABASE_PUBLIC_KEY is checked first, then
# SUPABASE_JWT_PUBLIC_KEY. Leave both unset to use JWKS discovery.
#SUPABASE_PUBLIC_KEY=
#SUPABASE_JWT_PUBLIC_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set to your exact frontend URL (no trailing slash).
# For local dev, include localhost ports used by Vite.
ALLOWED_ORIGINS=https://mailscope.dpdns.org,http://localhost:5173,http://localhost:3000

# ── Gemini AI Service ──────────────────────────────────────
# backend/app/services/gemini_service.py
# Leave unset to run entirely offline (deterministic fallback, no network calls).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Knowledge base embeddings (only used when GEMINI_API_KEY is set)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Live PCAP Folder Monitoring ────────────────────────────
# Set WATCH_DIR to auto-analyze PCAP files dropped into a folder.
# Unset = monitoring off; manual upload is unaffected.
#WATCH_DIR=watch
#WATCH_POLL_SECONDS=5

# ── Threat Intelligence Feed ───────────────────────────────
# Hours between re-downloading the abuse.ch SSLBL blacklist.
# No API key needed; on failure cached/no data is used and analysis proceeds.
THREAT_INTEL_REFRESH_HOURS=24
