# Gemini AI Service (backend/app/services/gemini_service.py)
# Leave GEMINI_API_KEY unset to run entirely offline (deterministic explanation
# engine + offline lexical knowledge-base retrieval, no network calls).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Knowledge base embeddings (backend/app/services/knowledge_base.py)
# Only used when GEMINI_API_KEY is set; otherwise the offline hashing-based
# embedding fallback is used automatically.
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Live monitoring (backend/app/services/pcap_watcher.py)
# Set WATCH_DIR to a folder to auto-analyze captures dropped into it.
# Unset = monitoring off; manual upload is unaffected.
#WATCH_DIR=watch
#WATCH_POLL_SECONDS=5
