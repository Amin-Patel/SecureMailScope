# SecureMailScope Environment Configuration Template

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
# Supabase Authentication & History Integration (Optional for local PCAP analysis)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# Backend API URL (Defaults to http://localhost:8001 if omitted)
VITE_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# -----------------------------------------------------------------------------
# Google Gemini API Key for AI-assisted remediation narratives (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8001
